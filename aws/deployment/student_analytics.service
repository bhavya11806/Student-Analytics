[Unit]
Description=Gunicorn instance to serve Student Attendance & Performance Analytics Cloud
After=network.target

[Service]
User=ubuntu
Group=www-data
WorkingDirectory=/var/www/student_analytics
Environment="PATH=/var/www/student_analytics/venv/bin"
EnvironmentFile=/var/www/student_analytics/.env
ExecStart=/var/www/student_analytics/venv/bin/gunicorn --workers 3 --bind 127.0.0.1:5000 run:app --access-logfile /var/log/student_analytics_access.log --error-logfile /var/log/student_analytics_error.log
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
